# Copy to backend/.env (gitignored). Leave ANTHROPIC_API_KEY empty to run without the chat agent:
# the agent route then returns 503 and everything else works.
DATABASE_URL=postgresql://aei:aei@localhost:5432/aei
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_FALLBACKS=true
