// AMRight on Azure. Resource-group scope: rg-junctionturku already exists.
targetScope = 'resourceGroup'

@description('Environment name, used in resource names and tags.')
param env string = 'demo'
@description('Region for everything except the Static Web App.')
param location string = 'norwayeast'
@description('Static Web Apps is not available in Norway East.')
param swaLocation string = 'westeurope'
param owner string = 'junction-turku'
param anthropicModel string = 'claude-sonnet-5-5'
@allowed(['low', 'medium', 'high'])
param agentEffort string = 'medium'
param asOfDefault string = '2026-09-27'
@description('Object ID of the person who administers Key Vault.')
param adminObjectId string
param postgresAdminLogin string = 'aeiadmin'
@secure()
@description('Generated by scripts/deploy.sh, reused if the vault already holds one.')
param postgresAdminPassword string
@secure()
@description('Generated by scripts/deploy.sh, reused if the vault already holds one.')
param apiKey string
@description('Extra CORS origins, comma separated. The Static Web App origin is added automatically. These also skip the API key (backend/app/auth.py), so no localhost here: run the app locally against a local API.')
param extraCorsOrigins string = 'https://amright.mankeli.co'

var prefix = 'aei-${env}'
var suffix = take(uniqueString(resourceGroup().id), 5)
var tags = {
  project: 'aei'
  env: env
  owner: owner
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: { name: prefix, location: location, tags: tags }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    name: '${prefix}-pg-${suffix}'
    location: location
    tags: tags
    adminLogin: postgresAdminLogin
    adminPassword: postgresAdminPassword
  }
}

module keyvault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  params: {
    name: '${prefix}-kv-${suffix}'
    location: location
    tags: tags
    adminObjectId: adminObjectId
    dbPassword: postgresAdminPassword
    // The password is alphanumeric (see deploy.sh), so it needs no URL encoding.
    databaseUrl: 'postgresql://${postgresAdminLogin}:${postgresAdminPassword}@${postgres.outputs.fqdn}:5432/aei?sslmode=require'
    apiKey: apiKey
  }
}

module staticWebApp 'modules/staticwebapp.bicep' = {
  name: 'staticwebapp'
  params: { name: '${prefix}-web', location: swaLocation, tags: tags }
}

module appService 'modules/appservice.bicep' = {
  name: 'appservice'
  params: {
    planName: '${prefix}-plan'
    siteName: '${prefix}-api-${suffix}'
    location: location
    tags: tags
    keyVaultName: keyvault.outputs.name
    keyVaultUri: keyvault.outputs.uri
    corsOrigins: 'https://${staticWebApp.outputs.hostname},${extraCorsOrigins}'
    appInsightsConnectionString: monitoring.outputs.appInsightsConnectionString
    anthropicModel: anthropicModel
    agentEffort: agentEffort
    asOfDefault: asOfDefault
  }
}

output apiUrl string = 'https://${appService.outputs.hostname}'
output staticWebAppUrl string = 'https://${staticWebApp.outputs.hostname}'
output staticWebAppName string = staticWebApp.outputs.name
output postgresHost string = postgres.outputs.fqdn
output postgresName string = postgres.outputs.name
output keyVaultName string = keyvault.outputs.name
output webAppName string = appService.outputs.name
output appInsightsConnectionString string = monitoring.outputs.appInsightsConnectionString
